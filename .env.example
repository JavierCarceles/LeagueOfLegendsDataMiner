# Copia este fichero como .env y rellena lo que necesites.

# API key de Riot (https://developer.riotgames.com/). También se puede pegar
# desde la web en «Datos y API»; se recarga en caliente sin reiniciar.
RIOT_API_KEY=

# Claves de Google Gemini para generar guías con IA (opcional).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
# Modelos a probar en orden (opcional).
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Servidor (por defecto solo accesible desde tu ordenador).
# HOST=127.0.0.1
# PORT=8000

# Datos de OP.GG (counters, tier list, guías de matchup). 0 para desactivar.
# OPGG_ENABLED=1

# Segunda fuente estadística (Lolalytics) y notas de parche oficiales de Riot.
# LOLALYTICS_ENABLED=1
# PATCHNOTES_ENABLED=1

# Precarga en segundo plano: descarga sola lo que usa la web para que todo
# abra al instante. 0 para desactivarla (los datos se bajarían al entrar).
# PRELOAD_ENABLED=1

# Pausar las descargas en segundo plano (precarga y recolector) mientras
# juegas, si el cliente de LoL está abierto en este ordenador.
# PAUSE_IN_GAME=1

# Windows: prioridad baja del proceso para que el juego siempre vaya primero.
# LOW_PRIORITY=1

# Colas que alimentan tus estadísticas propias (420 SoloQ, 440 Flex).
# STATS_QUEUES=420,440

# Idioma de nombres de campeones (Data Dragon).
# DDRAGON_LANG=es_ES

# Carpeta de instalación de LoL si no es la de por defecto (para detectar tu
# cuenta y el final de cada partida desde el cliente abierto).
# LOL_INSTALL_DIR=C:/Riot Games/League of Legends

# Carpetas (opcional).
# DATA_DIR=data
# COACHINGS_DIR=data/coachings
