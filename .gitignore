# Secretos y configuración local
.env
docs/enlaces.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.cache/

# Datos generados (se reconstruyen solos)
data/lol.db
data/lol.db-*
data/run.json
data/.run.lock
data/ddragon/
data/riot_key_state.json
data/.autopush.json
data/*.tmp
data/raw_otp/
data/registro/app_vivo.log*
data/registro/videos_vivo.log*
data/registro/*.tmp
# Resúmenes por campeón: se rehacen solos con las partidas (no se suben: eran un tercio de lo que crecía el
# repositorio). La subida automática los quita del índice sin borrarlos del disco (app/autopush.py).
data/otps/*/resumen.json
data/partidas_campeon/*/resumen.json
# Actualización automática (qué versión se instaló y si arrancó) y cupo de la API entre reinicios: de este ordenador
data/.update.json
data/.ratelimit.json
# Recolector de vídeos: cookies de YouTube opcionales (son tu sesión: nunca a GitHub)
data/videos/cookies.txt
# Grabaciones de tus partidas: los vídeos se quedan en este ordenador (su análisis .json sí se sube)
data/grabaciones/*.mp4
data/grabaciones/*.trabajo/
*.tmp

# Editores / sistema
.vscode/
.idea/
.DS_Store
Thumbs.db

# Copias de seguridad locales
*.bak
